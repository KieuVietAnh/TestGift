ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:10000
WEB_DOMAIN=gift.example.com

# Supabase: use the Session pooler on port 5432.
ConnectionStrings__DefaultConnection=Host=YOUR_POOLER_HOST;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=20
Database__AutoMigrate=true

Cors__AllowedOrigins=https://gift.example.com
AppUrls__FrontendBaseUrl=https://gift.example.com

Jwt__Key=GENERATE_A_LONG_RANDOM_SECRET
Jwt__Issuer=TetGift
Jwt__Audience=TetGiftUsers
Jwt__ExpireMinutes=60

Otp__Secret=GENERATE_ANOTHER_LONG_RANDOM_SECRET
Otp__ExpireMinutes=5
Otp__DeletePendingAfterMinutes=30

# Set these only for the first deployment, then remove Seed__AdminPassword.
Seed__AdminUsername=admin
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=CHOOSE_A_STRONG_ONE_TIME_PASSWORD

Resend__ApiKey=
Resend__From=TetGift <noreply@YOUR_VERIFIED_DOMAIN>

CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=

Gemini__ApiKey=
Gemini__Model=gemini-2.5-flash

VnPay__Url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VnPay__TmnCode=
VnPay__HashSecret=
VnPay__ReturnUrl=https://gift.example.com/payments/vnpay-return

# Optional. Leave empty to use in-memory cache on one API instance.
RedisOptions__ConnectionString=
RedisOptions__InstanceName=TetGift_

Swagger__Enabled=true
Order__AutoConfirmAfterDays=3
