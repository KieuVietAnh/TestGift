{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AutoMigrate": false
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "Jwt": {
    "Issuer": "TetGift",
    "Audience": "TetGiftUsers",
    "ExpireMinutes": 60
  },
  "Otp": {
    "ExpireMinutes": 5,
    "DeletePendingAfterMinutes": 30
  },
  "Resend": {
    "From": "TetGift <noreply@example.com>"
  },
  "VnPay": {
    "Url": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
  },
  "Gemini": {
    "Model": "gemini-2.5-flash"
  },
  "RedisOptions": {
    "InstanceName": "TetGift_"
  },
  "AppUrls": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Swagger": {
    "Enabled": true
  }
}
